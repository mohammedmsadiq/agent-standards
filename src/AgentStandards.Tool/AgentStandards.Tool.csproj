<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <RootNamespace>AgentStandards.Tool</RootNamespace>
    <AssemblyName>agent-standards</AssemblyName>

    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>agent-standards</ToolCommandName>
    <PackageId>AgentStandards.Tool</PackageId>
    <Title>Agent Standards CLI</Title>
    <Description>Vendor-neutral CLI that installs, updates, validates and customises shared engineering standards, skills and agents for AI coding assistants (Claude Code, GitHub Copilot) in any repository. Safe updates with manifests, conflict detection, dry-run and rollback. Not a runtime dependency of your application.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentStandards.Core\AgentStandards.Core.csproj" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- The tool bundles the templates that match its own version, so 'init' works offline. -->
  <Import Project="..\..\build\BundledTemplates.targets" />
</Project>
